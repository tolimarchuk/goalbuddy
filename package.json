{
  "name": "goalbuddy",
  "version": "0.5.0",
  "description": "A goal operating loop for Codex and Claude Code: goal oracles, local boards, receipts, and verification.",
  "type": "module",
  "bin": {
    "goalbuddy": "internal/cli/goal-maker.mjs",
    "goal-maker": "internal/cli/goal-maker.mjs"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md",
    "docs/releases",
    "plugins/goalbuddy",
    "internal/assets",
    "internal/cli",
    "goalbuddy"
  ],
  "scripts": {
    "check": "node internal/cli/check.mjs",
    "test": "node internal/cli/check.mjs --tests-only",
    "pack:dry-run": "npm pack --dry-run",
    "sync:plugin": "node internal/cli/sync-skill-tree.mjs --write",
    "postinstall": "node internal/cli/postinstall.mjs",
    "publish:check": "node internal/cli/check-publish-version.mjs && npm run pack:dry-run",
    "prepublishOnly": "node internal/cli/check-publish-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolimarchuk/goalbuddy.git"
  },
  "keywords": [
    "codex",
    "codex-skill",
    "openai-codex",
    "claude-code",
    "claude-code-plugin",
    "claude-code-skill",
    "anthropic",
    "goalbuddy",
    "goal",
    "task-board",
    "receipts",
    "project-management",
    "automation",
    "cli",
    "workflow",
    "agent",
    "verification"
  ],
  "author": "tolimarchuk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tolimarchuk/goalbuddy/issues"
  },
  "homepage": "https://github.com/tolimarchuk/goalbuddy#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
